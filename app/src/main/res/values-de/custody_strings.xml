    <string name="custody_week1_to_mom">Woche 1 → Mama</string>
    <string name="custody_week2_to_mom">Woche 2 → Mama</string>
    <!-- Replaces custody_week1_to_mom/custody_week2_to_mom: "Woche" (week) does not inflect
         for the referent's gender. %1$d is the week number, %2$s is the parent's name. -->
    <string name="custody_week_to">Woche %1$d: %2$s</string>

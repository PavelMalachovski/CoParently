    <!-- Replaces custody_mom_starts_first/custody_dad_starts_first. "Beginnt" (3rd person
         singular) and the adverb "zuerst" never inflect for gender, so the label stays safe
         next to any name. %1$s is that parent's name. -->
    <string name="custody_starts_first">Beginnt zuerst: %1$s</string>

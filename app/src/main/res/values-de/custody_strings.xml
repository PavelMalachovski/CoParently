    <string name="custody_dad">Papa</string>
    <!-- Replaces custody_with_mom/custody_with_dad (strings.xml). "Bei:" as a bare label
         needs no article, so it never has to agree with the name that follows. %1$s is that
         parent's name. -->
    <string name="custody_with">Bei: %1$s</string>

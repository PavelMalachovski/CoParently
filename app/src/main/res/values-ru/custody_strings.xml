<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="custody_title">График опеки</string>
    <string name="custody_back">Назад</string>
    <string name="custody_save_button">Сохранить график опеки</string>
    <string name="custody_select_schedule_type">Выберите тип графика</string>
    <string name="custody_pattern_start_date">Дата начала цикла</string>
    <string name="custody_start_date_hint">Это опорная дата — цикл будет повторяться начиная с этого дня</string>
    <string name="custody_who_starts_first">Кто начинает первым?</string>
    <!-- Replaces custody_mom_starts_first/custody_dad_starts_first: dropping "первым/первой"
         removes the adjective that would otherwise have to agree with the name. %1$s is that
         parent's name. -->
    <string name="custody_starts_first">Начинает: %1$s</string>
    <string name="custody_custom_pattern">Свой шаблон</string>
    <!-- The two names are colour labels, not grammatical objects: "Pink: <name>" so
         nothing has to agree with the name. The old value named Mom and Dad outright
         and, in ru/uk/cs, put them in a governed case. %1$s is slot 1, %2$s is slot 2. -->
    <string name="custody_custom_pattern_hint">Нажмите на день, чтобы изменить, чей он. Розовый: %1$s. Синий: %2$s.</string>
    <string name="custody_week_abbrev">Н%1$d</string>
    <string name="custody_day_abbrev">Д%1$d</string>
    <!-- Replaces custody_week1_to_mom/custody_week2_to_mom: "неделя" (week) does not inflect
         for the referent's gender. %1$d is the week number, %2$s is the parent's name. -->
    <string name="custody_week_to">Неделя %1$d: %2$s</string>
    <string name="custody_preview">Предпросмотр</string>
    <string name="custody_next_14_days">Следующие 14 дней:</string>
    <!-- Replaces custody_with_mom/custody_with_dad (strings.xml). "С кем" (with whom) is a
         fixed question phrase, so the name that follows never has to agree. %1$s is that
         parent's name. -->
    <string name="custody_with">С кем: %1$s</string>
    <string name="custody_ok">OK</string>
    <string name="custody_cancel">Отмена</string>
    <string name="custody_model_week_on_week_off">Неделя через неделю</string>
    <string name="custody_model_two_two_three">Схема 2-2-3</string>
    <string name="custody_model_three_four_four_three">Схема 3-4-4-3</string>
    <string name="custody_model_custom">Свой график</string>
    <string name="custody_model_week_on_week_off_desc">Ребёнок целую неделю у одного родителя, затем родители меняются.</string>
    <string name="custody_model_two_two_three_desc">Схема 2 дня, 2 дня, 3 дня. Более частые переходы.</string>
    <string name="custody_model_three_four_four_three_desc">Чередование 3 и 4 дней. Сбалансированное время в будни и выходные.</string>
    <string name="custody_model_custom_desc">Создайте собственный шаблон графика.</string>
</resources>

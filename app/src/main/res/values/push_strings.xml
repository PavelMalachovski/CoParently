<?xml version="1.0" encoding="utf-8"?>
<!--
  Push notification text (SEC-3).

  These are composed on the **receiving** device, not by the phone that sent the notification
  and not on a server. A queued payload carries a type and the few names it needs; this file
  is the sentence. That is what makes the frame — "New event", "Change requested" — something
  nobody can forge, and it is also why the notification arrives in the reader's language
  rather than the sender's.

  Every %1$s / %2$s is a name a person typed: a parent's display name, an event's title, a
  child's name. Keep them out of positions where the surrounding grammar has to agree with
  them, the same rule the custody preview strings follow.
-->
<resources>
    <string name="push_event_created_title">New event</string>
    <string name="push_event_created_body">%1$s added “%2$s”</string>
    <string name="push_event_updated_title">Event changed</string>

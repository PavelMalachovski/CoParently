<?xml version="1.0" encoding="utf-8"?>
<!-- Custody setup screen strings. Kept out of strings.xml because
     strings.xml is gitignored in this project (it holds local OAuth values). -->
<resources>
    <string name="custody_title">Custody Schedule</string>
    <string name="custody_back">Back</string>
    <string name="custody_save_button">Save Custody Schedule</string>
    <string name="custody_select_schedule_type">Select Schedule Type</string>
    <string name="custody_pattern_start_date">Pattern Start Date</string>
    <string name="custody_start_date_hint">This is the anchor date - the pattern will repeat from this day</string>
    <string name="custody_who_starts_first">Who Starts First?</string>
    <!-- Replaces custody_mom_starts_first/custody_dad_starts_first: a label the parent's
         name can sit next to without a verb agreeing with it. %1$s is that parent's name. -->
    <string name="custody_starts_first">Starts first: %1$s</string>
    <string name="custody_custom_pattern">Custom Pattern</string>
    <!-- The two names are colour labels, not grammatical objects: "Pink: <name>" so
         nothing has to agree with the name. The old value named Mom and Dad outright
         and, in ru/uk/cs, put them in a governed case. %1$s is slot 1, %2$s is slot 2. -->
    <string name="custody_custom_pattern_hint">Tap a day to switch whose it is. Pink: %1$s. Blue: %2$s.</string>
    <!-- Abbreviated week label in the custom-pattern day grid, e.g. "W1". -->
    <string name="custody_week_abbrev">W%1$d</string>
    <!-- Abbreviated day label in the custom-pattern day grid, e.g. "D3". -->
    <string name="custody_day_abbrev">D%1$d</string>
    <!-- Replaces custody_week1_to_mom/custody_week2_to_mom: a plain "Week N: name" pair, never
         a sentence. %1$d is the week number, %2$s is the parent's name. -->
    <string name="custody_week_to">Week %1$d: %2$s</string>
    <string name="custody_preview">Preview</string>
    <string name="custody_next_14_days">Next 14 days:</string>
    <string name="custody_ok">OK</string>
    <string name="custody_cancel">Cancel</string>
    <!-- Custody pattern names (UI labels for CustodyModelType). -->
    <string name="custody_model_week_on_week_off">Week On / Week Off</string>
    <string name="custody_model_two_two_three">2-2-3 Split</string>
    <string name="custody_model_three_four_four_three">3-4-4-3 Split</string>
    <string name="custody_model_custom">Custom Schedule</string>
    <string name="custody_model_week_on_week_off_desc">One parent has the child for a full week, then they switch.</string>
    <string name="custody_model_two_two_three_desc">2 days, 2 days, 3 days pattern. More frequent transitions.</string>
    <string name="custody_model_three_four_four_three_desc">3 days, 4 days alternating. Balanced mid-week and weekend time.</string>
    <string name="custody_model_custom_desc">Create your own schedule pattern.</string>
    <!-- Preview sentences for the custody Preview card. These replace a hardcoded
         English string built in CustodySetupViewModel that named Mom and Dad outright.
         Each name follows a colon or a dash and is never the subject of a verb or the
         head of an adjective, so nothing has to agree with it. %1$s/%2$s are the two
         parents in pattern order; custody_preview_custom takes the two day counts
         first and the slot-1 parent last. -->
    <string name="custody_preview_week_on_week_off">First week: %1$s, then it alternates every week.</string>
    <string name="custody_preview_two_two_three">Mon–Tue: %1$s. Wed–Thu: %2$s. Fri–Sun alternates.</string>
    <string name="custody_preview_three_four_four_three">Mon–Wed (3 days): %1$s. Thu–Sun (4 days): %2$s. Then it reverses.</string>
    <string name="custody_preview_custom">Custom pattern: %1$d of %2$d days — %3$s.</string>

    <!-- The pairing conflict screen. Every caption here is a noun label and a value, never a
         sentence a name is the subject of: Czech, Russian and Ukrainian inflect verbs for
         gender and a name cannot agree with one, and this screen names two people beside two
         schedules. -->
    <string name="custody_conflict_title">Two schedules</string>
    <string name="custody_conflict_body">This phone and the shared calendar hold different custody patterns. Pick the one that applies. The other stays saved, no longer active.</string>
    <string name="custody_conflict_local_label">On this phone</string>
    <string name="custody_conflict_shared_label">Shared schedule</string>
    <string name="custody_conflict_keep_local">Keep the schedule on this phone</string>
    <string name="custody_conflict_use_shared">Use the shared schedule</string>
    <string name="custody_conflict_save_failed">The schedule could not be saved. Try again.</string>
    <string name="custody_proposal_inbox_title">New custody schedule proposed</string>
    <string name="custody_proposal_inbox_body">%1$s proposes a new custody schedule. It will not change your calendar until you accept it.</string>
    <string name="custody_proposal_accept">Accept</string>
    <string name="custody_proposal_decline">Decline</string>
    <string name="custody_proposal_waiting">Waiting for your co-parent to approve the new schedule</string>
    <string name="custody_proposal_review">%1$s proposed a new custody schedule</string>
    <!-- MON-6: sole custody with contact every second weekend, the arrangement a large
         share of Czech families have. The switch above the preview asks a different question
         for this pattern than for the alternating ones — see CustodySetupScreen.rolesQuestionFor. -->
    <string name="custody_model_every_other_weekend">Every Other Weekend</string>
    <string name="custody_model_every_other_weekend_desc">The child lives with one parent; the other has every second weekend.</string>
    <string name="custody_preview_every_other_weekend">Every day: %1$s. Every second Sat–Sun: %2$s.</string>
    <string name="custody_who_is_resident">Who does the child live with?</string>
    <string name="custody_is_resident">Lives with: %1$s</string>
    <string name="custody_midweek_title">Midweek contact</string>
    <string name="custody_midweek_enable">Add a midweek day</string>
    <string name="custody_midweek_overnight_warning">This schedule assigns whole days, so a midweek day includes the overnight. If your order says afternoon only, build the fortnight under Custom instead.</string>
    <string name="custody_midweek_every_week">Every week</string>
    <string name="custody_midweek_off_week_only">Only the week without the weekend</string>
    <string name="custody_preview_every_other_weekend_midweek">Every day: %1$s. Every second Sat–Sun and every %3$s: %2$s.</string>
    <string name="custody_preview_every_other_weekend_midweek_off_week">Every day: %1$s. Every second Sat–Sun, plus %3$s in the week between: %2$s.</string>
    <plurals name="custody_diff_days_move">
        <item quantity="one">%1$d day would move over the coming weeks.</item>
        <item quantity="other">%1$d days would move over the coming weeks.</item>
    </plurals>
    <string name="custody_diff_none">Nothing on the calendar would change.</string>
</resources>

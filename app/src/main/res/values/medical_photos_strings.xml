         reference anyway would leave an image nobody can see and nobody can delete. -->
    <string name="medical_photos_upload_failed">That photograph could not be uploaded, so it was not attached.</string>
    <string name="medical_photos_delete_failed">That photograph could not be deleted, so it is still attached.</string>

    <!-- The segmented control on the Expenses screen. Both views share one month control. -->
    <string name="expense_analytics_tab_list">List</string>
    <string name="expense_analytics_tab_analytics">Analytics</string>
    <string name="expense_analytics_view_label">View</string>

    <!-- Payer filter. The two parent options are named with each parent's own name, never
         "Mom" or "Dad"; only the "everyone" option needs a string. -->
    <string name="expense_analytics_payer_everyone">Everyone</string>
    <string name="expense_analytics_payer_label">Whose spending</string>


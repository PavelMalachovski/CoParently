         category's colour, so identity is never colour alone. -->
    <string name="expense_analytics_column_category">Category</string>
    <string name="expense_analytics_column_amount">Amount</string>
    <string name="expense_analytics_column_share">Share</string>
    <string name="expense_analytics_total">Total</string>

    <string name="expense_analytics_empty">Nothing spent this month.</string>
    <string name="expense_analytics_empty_filtered">Nothing spent by this parent this month.</string>

<?xml version="1.0" encoding="utf-8"?>
<!-- Chat feature strings. Kept out of strings.xml because strings.xml is
     gitignored in this project (it holds local OAuth values). -->
<resources>
    <string name="chat_new_conversation">New Conversation</string>
    <string name="chat_empty_title">No conversations yet</string>
    <string name="chat_empty_description">Start a conversation with your co-parent to coordinate schedules and share updates.</string>
    <string name="chat_no_messages">No messages yet</string>
    <string name="chat_messages_empty_title">No messages yet</string>
    <string name="chat_messages_empty_description">Start the conversation by sending a message to your co-parent.</string>
    <string name="chat_type_message">Type a message…</string>
    <string name="chat_send">Send</string>
    <string name="chat_status_sending">Sending</string>
    <string name="chat_status_error">Error</string>
    <string name="chat_status_sent">Sent</string>
    <!-- Tick content description: the message reached the co-parent's device but has not been read yet. -->
    <string name="chat_status_delivered">Delivered</string>
    <!-- Tick content description: the co-parent has opened the thread past this message. -->
    <string name="chat_status_read">Read</string>
    <string name="chat_sending_ellipsis">Sending…</string>
    <string name="chat_failed_to_send">Failed to send</string>
    <string name="chat_title_fallback">Chat</string>
    <string name="chat_back">Back</string>
    <string name="chat_request_change">Request change</string>
    <string name="chat_request_change_title">Request a change</string>
    <string name="chat_no_upcoming_events">No upcoming events to propose a change for.</string>
    <string name="chat_pick_event_to_reschedule">Pick the event you\'d like to reschedule:</string>
    <!-- Shown when the co-parent action is used on an account that has no co-parent linked. -->
    <string name="chat_no_coparent">You are not linked with a co-parent yet.</string>
    <!-- Snackbar action next to chat_no_coparent; opens the pairing screen. -->
    <string name="chat_no_coparent_action">Pair</string>
    <!-- Shown when the pairing state has not resolved in time; the action is worth retrying. -->
    <string name="chat_coparent_link_pending">Still checking your co-parent link. Try again in a moment.</string>

    <!-- Screen-reader content description for the unread-message badge on the bottom nav's Chat tab. -->
    <plurals name="chat_unread_messages_badge">
        <item quantity="one">%1$d unread message</item>
        <item quantity="other">%1$d unread messages</item>
    </plurals>
    <!-- Visible badge text once the unread count passes the display cap, e.g. "99+". -->
    <string name="chat_unread_count_overflow">%1$d+</string>

    <!-- Composer action chips and day separators (Aug 2026 design refresh). -->
    <string name="chat_templates">Templates</string>
    <string name="chat_day_today">Today</string>
    <string name="chat_day_yesterday">Yesterday</string>

    <!-- Thread header: whether your own messages actually left the device. -->
    <string name="chat_header_synced">Up to date</string>

    <!-- Accessibility label for the change-request card's clickable bubble. -->
    <string name="chat_open_change_request">Open the change request</string>

    <!-- Message templates (domain/model/MessageTemplate.kt). The body is seeded into the
         composer for the user to edit before sending, so the bracketed hints are translated
         too: they are prompts to the reader, not substitution tokens. -->
    <string name="chat_templates_sheet_title">Message Templates</string>
    <string name="chat_template_category_pickup_drop">Pickup &amp; Drop-off</string>
    <string name="chat_template_category_illness">Illness &amp; Medical</string>
    <string name="chat_template_category_school_events">School Events</string>
    <string name="chat_template_category_holidays">Holidays &amp; Vacation</string>
    <string name="chat_template_category_conflict_resolution">Conflict Resolution</string>
    <string name="chat_template_pickup_delay_title">Running late for handover</string>
    <string name="chat_template_pickup_delay_content">I am running late for the handover of [child]. I should be there in about [number of minutes]. Sorry for the inconvenience.</string>
    <string name="chat_template_pickup_early_title">Arriving earlier</string>
    <string name="chat_template_pickup_early_content">I will arrive earlier than usual, at around [time]. Does that work for you?</string>
    <string name="chat_template_doctor_visit_title">Doctor\'s visit</string>
    <string name="chat_template_doctor_visit_content">[Child] saw the doctor today about [symptom]. Diagnosis: [diagnosis]. The doctor recommends [recommendation].</string>
    <string name="chat_template_child_sick_title">Child is unwell</string>
    <string name="chat_template_child_sick_content">[Child] is not feeling well. Symptoms: [symptoms]. Temperature: [temperature]. I am staying at home with them.</string>
    <string name="chat_template_school_event_title">School event</string>
    <string name="chat_template_school_event_content">The school has [event] on [date] at [time]. Will you be able to attend?</string>
    <string name="chat_template_parent_teacher_meeting_title">Parent-teacher meeting</string>
    <string name="chat_template_parent_teacher_meeting_content">The parent-teacher meeting is on [date] at [time]. The teacher would like to discuss [topic].</string>
    <string name="chat_template_holiday_plan_title">Holiday plan</string>
    <string name="chat_template_holiday_plan_content">Let\'s agree on the plan for [holiday]. My suggestion is [proposal]. What do you think?</string>
    <string name="chat_template_schedule_change_title">Schedule change</string>
    <string name="chat_template_schedule_change_content">I need to change the schedule for [date]. Could we swap? I would take [alternative date].</string>
</resources>

rules_version = '2';

// Cloud Storage rules for CoPlanly.
//
// Receipt photos are stored at receipts/{expenseId}.jpg. Reads and writes require
// authentication; download URLs embedded in Firestore documents carry an access
// token and keep working for the paired parent regardless of these read rules.
//
// None of these blocks can tell one signed-in user from another: Storage rules cannot read
// Firestore, so none of them knows who a parent of what is. See the medical_photos block, which
// says at length what that costs and why it was accepted there.
//
// ---------------------------------------------------------------------------------------
// WRITE IS THE WORSE HALF, AND IT WAS UNDOCUMENTED UNTIL THE AUGUST 2026 AUDIT.
//
// The read exposure below is argued for at length. The write rules are the same
// `request.auth != null` and nobody wrote down what that means: **any signed-in CoPlanly user
// who learns an object's path can overwrite it or delete it.** `request.resource == null` is a
// delete, and every block admits it. A path is not a secret — `receipts/{expenseId}.jpg` and
// `event_images/{eventId}.jpg` are built from ids any co-parent has held, and an ex-partner's
// local Room copy survives both sign-out and the unpair sweep, so those ids outlive the link
// the sweep revoked.
//
// So the failure is not only disclosure. It is an ex-partner deleting the other parent's
// receipts, or replacing a photograph attached to a child's medical record with a different
// image, in a product whose records are used to settle disagreements about what happened.
//
// This was deliberately NOT patched with an owner check in that audit, and the reason is worth
// keeping: both parents legitimately manage the same objects (the `child_info` update rule
// admits the creator *and* their partner), so a rule keyed on the uploader's uid would deny the
// co-parent a deletion the app offers them. Per-object metadata naming the audience is
// enforceable here and would fit that model, but it needs the client to stamp it, a decision
// about objects already in the bucket that carry no such stamp, and a check against the guest
// and friend read paths — a change of its own size.
//
// The fix the medical_photos block already names is the fix for this too: a Cloud Function
// proxy that resolves the caller against Firestore and is the only writer with credentials.
// Until then, treat every block below as: authenticated == may read, overwrite and delete.
// ---------------------------------------------------------------------------------------
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{fileName} {
      allow read: if request.auth != null;
      // Deletes have request.resource == null; uploads must be JPEG under 5 MB.
      allow write: if request.auth != null
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType == 'image/jpeg'));
    }

    // Event photos, stored at event_images/{eventId}.jpg, same constraints as receipts.
    match /event_images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType == 'image/jpeg'));
    }

    // Photographs attached to a child's medical notes, at
    // medical_photos/{childInfoId}/{photoId}.jpg — several per child, unlike the two blocks
    // above, which derive one fixed object from an entity id.
    //
    // READ THIS BEFORE WIDENING ANYTHING HERE. The read rule below is the same
    // "any authenticated user" as receipts and event_images, and for a receipt that was judged
    // acceptable. A photograph of a child's medical record is not the same thing, and
    // "any signed-in CoPlanly user" is not an audience it should have.
    //
    // Storage rules cannot read Firestore, so they cannot ask whether the caller is a parent of
    // this child. The two honest options were an unguessable path plus the download URL's access
    // token, or a Cloud Function proxy. This takes the first, and {photoId} is a UUID for that
    // reason rather than for uniqueness.
    //
    // That is obscurity, not access control. It is written here so a future reader does not
    // mistake it for a boundary: anyone signed in who learns a path can read the object, and the
    // only thing stopping them learning it is that they cannot guess a UUID. The real fix is the
    // proxy.
    match /medical_photos/{childInfoId}/{fileName} {
      allow read: if request.auth != null;
      // Same constraints as the blocks above: deletes have request.resource == null; uploads
      // must be JPEG under 5 MB.
      allow write: if request.auth != null
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType == 'image/jpeg'));
    }

    // Pet photographs, at pet_photos/{petId}/{photoId}.jpg — several per pet, the same
    // shape as medical_photos above. The same caveat applies: this read rule is "any
    // authenticated user", so the unguessable {photoId} UUID path is doing the work a
    // real access rule cannot express here. That is obscurity, not access control — a pet
    // photo is less sensitive than a child's medical record, but the mechanism is
    // identical, and the real fix is the same proxy.
    match /pet_photos/{petId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType == 'image/jpeg'));
    }

    // Everything else is closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
